---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---
<nav class="text-xs text-ink-500 not-prose" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((item, idx) => (
      <li class="flex items-center gap-1.5">
        {idx > 0 && <span class="i-lucide-chevron-right text-ink-400" aria-hidden="true"></span>}
        {idx === items.length - 1
          ? <span class="text-ink-700 dark:text-ink-300" aria-current="page">{item.name}</span>
          : <a class="hover:text-ink-900 dark:hover:text-ink-100" href={item.url}>{item.name}</a>
        }
      </li>
    ))}
  </ol>
</nav>
