---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../../layouts/ArticleSeo.astro';
import { howTo } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/sign-documents-online');
if (!entry) throw new Error('Missing content/pages/en/sign-documents-online.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT2M',
  steps: [
    {
      name: 'Open the app',
      text: 'Visit app.firmar.ec in your browser, on desktop or mobile.',
      url: 'https://app.firmar.ec/',
    },
    {
      name: 'Upload the PDF document',
      text: 'Drag or select the document you want to sign; it never leaves your device.',
    },
    {
      name: 'Load your .p12 certificate and sign',
      text: 'Enter the password, place the visible seal and confirm. The PAdES signature is computed in your browser.',
    },
    {
      name: 'Download the signed PDF',
      text: 'The document is signed with PAdES (ETSI EN 319 142), valid before SRI, banks and public institutions.',
    },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'firmar-documentos-en-linea',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
