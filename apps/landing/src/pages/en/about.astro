---
import { getEntry, render } from 'astro:content';
import OpenSourceCTAs from '../../components/OpenSourceCTAs.astro';
import ParaQuien from '../../components/ParaQuien.astro';
import Page from '../../layouts/Page.astro';
import { aboutPage } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/about');
if (!entry) throw new Error('Missing content/pages/en/about.md');
const { Content } = await render(entry);
const data = entry.data;

const pageProps = {
  title: data.title,
  description: data.description,
  routeKey: 'acerca' as const,
  ...(data.h1 !== undefined ? { h1: data.h1 } : {}),
  breadcrumbs: data.breadcrumbs,
};
---
<Page {...pageProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(aboutPage({ lang: 'en' }))}></script>
  <Fragment slot="after">
    <ParaQuien />
    <OpenSourceCTAs />
  </Fragment>
</Page>
