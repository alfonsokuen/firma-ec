---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../../layouts/ArticleSeo.astro';
import { howTo } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/verify-pdf-signature');
if (!entry) throw new Error('Missing content/pages/en/verify-pdf-signature.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT1M',
  steps: [
    {
      name: 'Open the verifier',
      text: 'Go to app.firmar.ec/verify in your modern browser.',
      url: 'https://app.firmar.ec/#/verificar',
    },
    { name: 'Load the signed PDF', text: 'Drag or select the PDF you want to check.' },
    {
      name: 'Read the result',
      text: 'Shows signer, issuing CA, date, integrity and certificate status (OCSP/CRL).',
    },
    {
      name: 'Verify the stamp QR (optional)',
      text: 'If the document carries a visible QR stamp, scan it to check it by its hash.',
    },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'verificar-firma-pdf',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
