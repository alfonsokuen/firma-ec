---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../layouts/ArticleSeo.astro';
import { howTo } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/verificar-firma-pdf');
if (!entry) throw new Error('Missing content/pages/es/verificar-firma-pdf.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT1M',
  steps: [
    {
      name: 'Abre el verificador',
      text: 'Visita app.firmar.ec/verificar en tu navegador moderno.',
      url: 'https://app.firmar.ec/#/verificar',
    },
    { name: 'Carga el PDF firmado', text: 'Arrastra o selecciona el PDF que quieres comprobar.' },
    {
      name: 'Lee el resultado',
      text: 'Muestra firmante, AC emisora, fecha, integridad y estado del certificado (OCSP/CRL).',
    },
    {
      name: 'Verifica el QR del sello (opcional)',
      text: 'Si el documento trae un sello visible con QR, escanéalo para comprobarlo por su hash.',
    },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'verificar-firma-pdf',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
