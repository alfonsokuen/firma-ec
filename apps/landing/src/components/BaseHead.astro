---
import '../styles/fonts.css';
import '../styles/tokens.css';
import { SITE } from '../lib/jsonld.ts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  hreflangs?: { es?: string; en?: string };
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  lang = 'es',
  ogImage = '/og/default.png',
  ogType = 'website',
  jsonld = [],
  hreflangs = {},
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="oklch(58% 0.21 245)" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="oklch(8% 0.03 250)" media="(prefers-color-scheme: dark)" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

{hreflangs.es && <link rel="alternate" hreflang="es-EC" href={hreflangs.es} />}
{hreflangs.en && <link rel="alternate" hreflang="en-US" href={hreflangs.en} />}
{(hreflangs.es || hreflangs.en) && <link rel="alternate" hreflang="x-default" href={hreflangs.es ?? hreflangs.en} />}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={lang === 'es' ? 'es_EC' : 'en_US'} />
<meta property="og:image" content={new URL(ogImage, SITE.url).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

<link rel="preload" href="/fonts/Geist-Display-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Geist-Sans-400.woff2" as="font" type="font/woff2" crossorigin />

<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{jsonld.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}
