---
import ComoFunciona from '../../components/ComoFunciona.astro';
import ExploraMas from '../../components/ExploraMas.astro';
import Hero from '../../components/Hero.astro';
import OperadoPor from '../../components/OperadoPor.astro';
import SponsorsStrip from '../../components/SponsorsStrip.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils.ts';
import Base from '../../layouts/Base.astro';
import { organization, softwareApplication, website } from '../../lib/jsonld.ts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const jsonld = [organization({ lang }), website({ lang }), softwareApplication({ lang })];
---
<Base
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  routeKey="home"
  ogImage="/og/home-en.png"
  jsonld={jsonld}
>
  <Hero />
  <ComoFunciona />
  <!-- Security, compatibility, who-it-is-for, compliance and open source live
       on their own pages (less scroll on the home); ExploraMas is the index. -->
  <ExploraMas />
  <SponsorsStrip />
  <OperadoPor />
</Base>
