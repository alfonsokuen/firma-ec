---
import { getLangFromUrl, localizedUrl } from '../i18n/utils.ts';
import WhatsAppIcon from './WhatsAppIcon.astro';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const sponsorsUrl = localizedUrl('patrocinar', lang);

// Contacto directo de patrocinios por WhatsApp (línea IDKMANAGER 0958888193).
const waSponsor = `https://wa.me/593958888193?text=${encodeURIComponent(
  es
    ? 'Hola, me interesa patrocinar firmar.ec. ¿Me comparten los detalles?'
    : "Hi, I'm interested in sponsoring firmar.ec. Could you share the details?",
)}`;

// Fuente única de patrocinadores (compartida con HeroSponsors.astro).
import { sponsors } from '../data/sponsors.ts';
---
<section id="patrocinadores" class="container py-16 md:py-24 scroll-mt-24" aria-labelledby="sponsors-strip-title">
  <header class="max-w-2xl mx-auto text-center mb-10" data-reveal>
    <p class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/25 bg-brand-500/[0.06] px-3 py-1 font-mono text-[0.7rem] uppercase tracking-[0.18em] text-brand-600 dark:text-brand-400 mb-3">
      <span class="inline-block size-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
      {es ? 'Patrocinadores' : 'Sponsors'}
    </p>
    <h2 id="sponsors-strip-title" class="font-display text-[clamp(1.5rem,1rem+2.5vw,2.5rem)] font-bold leading-[1.1] tracking-[-0.015em] mb-3 text-balance">
      {es ? 'Quienes hacen esto sostenible' : 'Who keeps this sustainable'}
    </h2>
    <p class="text-ink-600 dark:text-ink-300">
      {es
        ? 'firmar.ec es gratis y open source. Su desarrollo, las auditorías de seguridad y la infraestructura se sostienen con el apoyo de organizaciones que valoran la soberanía tecnológica.'
        : 'firmar.ec is free and open source. Its development, security audits and infrastructure are sustained by organizations that value technological sovereignty.'}
    </p>
  </header>

  {sponsors.length > 0 ? (
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-8 items-center">
      {sponsors.map((s) => (
        <li>
          <a
            href={s.url}
            rel="noopener"
            class="group flex items-center justify-center h-16 px-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950 rounded-md"
            aria-label={s.name}
          >
            <img
              src={s.logo}
              alt={s.name}
              loading="lazy"
              decoding="async"
              class="max-h-12 w-auto opacity-60 grayscale group-hover:opacity-100 group-hover:grayscale-0 transition-[opacity,filter] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)]"
            />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div>
      <ul class="grid grid-cols-2 sm:grid-cols-4 gap-4 m-0 p-0 list-none">
        <li class="col-span-2 sm:col-span-1">
          <a
            href={sponsorsUrl}
            class="group relative flex h-28 flex-col items-center justify-center gap-2 overflow-hidden rounded-xl border border-dashed border-brand-400/70 dark:border-brand-400/50 bg-brand-500/[0.06] dark:bg-brand-500/[0.12] hover:border-solid hover:bg-brand-500/[0.10] dark:hover:bg-brand-500/[0.16] hover:-translate-y-0.5 hover:shadow-[0_14px_36px_-14px_color-mix(in_oklch,oklch(52%_0.18_240)_55%,transparent)] transition-[transform,box-shadow,border-color,background-color] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
            aria-label={es ? 'Tu marca aquí — convertirme en patrocinador' : 'Your brand here — become a sponsor'}
          >
            <span class="i-lucide-sparkles text-2xl text-brand-500 transition-transform duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:scale-110" aria-hidden="true"></span>
            <span class="font-display text-sm font-semibold text-brand-700 dark:text-brand-300">
              {es ? 'Tu marca aquí' : 'Your brand here'}
            </span>
          </a>
        </li>
        {[0, 1, 2].map(() => (
          <li aria-hidden="true">
            <div class="flex h-28 items-center justify-center rounded-xl border border-dashed border-ink-300/70 dark:border-ink-700/70 bg-ink-100/30 dark:bg-ink-900/40">
              <span class="i-lucide-image text-2xl text-ink-300 dark:text-ink-700" aria-hidden="true"></span>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-col gap-5 rounded-xl border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-6 md:p-8 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-xl">
          <p class="font-display text-lg font-semibold mb-1">
            {es ? 'Sé la primera marca en aparecer aquí' : 'Be the first brand to appear here'}
          </p>
          <p class="text-sm text-ink-600 dark:text-ink-300">
            {es
              ? 'Tu logo en la página principal de la firma electrónica abierta del Ecuador, visto por profesionales, empresas y entidades públicas. Pago directo, sin intermediarios.'
              : 'Your logo on the home page of Ecuador’s open electronic signature, seen by professionals, businesses and public bodies. Direct payment, no intermediaries.'}
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-2.5 sm:flex-row sm:items-center">
          <a
            href={sponsorsUrl}
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-md bg-brand-500 text-white text-sm font-semibold ring-1 ring-brand-600/30 shadow-[0_4px_16px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_50%,transparent)] hover:-translate-y-px hover:shadow-[0_8px_24px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_60%,transparent)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
          >
            <span>{es ? 'Convertirme en patrocinador' : 'Become a sponsor'}</span>
            <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
          </a>
          <a
            href={waSponsor}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 h-11 px-5 rounded-md bg-[#17823F] text-white text-sm font-semibold ring-1 ring-[#1da851]/40 shadow-[0_4px_16px_-4px_color-mix(in_oklch,oklch(72%_0.19_150)_55%,transparent)] hover:-translate-y-px hover:bg-[#146E36] hover:shadow-[0_8px_24px_-4px_color-mix(in_oklch,oklch(72%_0.19_150)_65%,transparent)] transition-[transform,box-shadow,background-color] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
          >
            <WhatsAppIcon class="w-4 h-4" />
            <span>{es ? 'Escribir por WhatsApp' : 'Message on WhatsApp'}</span>
          </a>
        </div>
      </div>
    </div>
  )}
</section>
