---
import { getLangFromUrl, localizedUrl, useTranslations } from '../i18n/utils.ts';
import { storeLink } from '../lib/store.ts';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.svelte';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = localizedUrl('home', lang);
const buyUrl = storeLink('header');

// Single source of truth for the nav links so desktop + mobile never drift.
const navKeys = ['firmar', 'verificar', 'seguridad', 'faq', 'acerca', 'patrocinar'] as const;
// "Validar certificado" has its own SEO landing page (/validar-certificado/),
// inserted right after "Verificar". flatMap keeps the shared desktop + mobile
// list in sync.
const navLinks = navKeys.flatMap((key) => {
  const link = { href: localizedUrl(key, lang), label: t(`nav.${key}` as Parameters<typeof t>[0]) };
  if (key === 'verificar') {
    return [link, { href: localizedUrl('validar-certificado', lang), label: t('nav.validar') }];
  }
  return [link];
});
---
<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent transition-[box-shadow,border-color,background-color] duration-200 ease-out bg-ink-50/85 dark:bg-ink-950/85 backdrop-blur-md"
>
  <nav class="container flex items-center justify-between gap-4 h-16" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>
    <a href={home} class="flex shrink-0 items-center gap-2 font-display text-lg font-bold tracking-tight">
      <svg class="h-7 w-7 text-brand-500 shrink-0" viewBox="0 0 100 100" fill="none" aria-hidden="true">
        <path d="M58 22 C40 20, 44 40, 46 56 C48 76, 42 86, 30 80" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M30 48 C46 42, 62 44, 76 52" stroke="#C9821E" stroke-width="7" stroke-linecap="round"/>
      </svg>
      <span><span class="text-brand-500">firmar</span><span style="color:#C9821E">.ec</span></span>
    </a>
    <ul class="hidden md:flex items-center gap-1 text-sm font-medium">
      {navLinks.map((link) => (
        <li><a class="px-3 py-2 rounded-md hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors" href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <div class="flex shrink-0 items-center gap-1">
      <!-- Acceso a la tienda SIEMPRE visible en móvil (above-the-fold): el botón xl
           queda oculto en móvil y el menú hamburguesa no se ve "de primeras". -->
      <a
        href={buyUrl}
        data-cta="comprar_certificado"
        aria-label={lang === 'es' ? 'Comprar certificado' : 'Buy certificate'}
        class="md:hidden inline-flex items-center gap-1 h-9 px-2.5 rounded-md text-xs font-bold whitespace-nowrap shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
        style="background:#C9821E;color:#11201a"
      >
        <span class="i-lucide-shopping-bag text-base" aria-hidden="true"></span>
      </a>
      <a
        href={buyUrl}
        data-cta="comprar_certificado"
        class="hidden xl:inline-flex items-center gap-1.5 h-11 px-3.5 rounded-md text-sm font-semibold whitespace-nowrap shadow-sm hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
        style="background:#C9821E;color:#11201a"
      >
        <span class="i-lucide-shopping-bag text-base" aria-hidden="true"></span>
        <span>{lang === 'es' ? 'Comprar' : 'Buy'}</span>
      </a>
      <a
        href="https://app.firmar.ec/?install=1"
        data-cta="instalar_app"
        aria-label={t('cta.instalar_app')}
        class="hidden sm:inline-flex items-center gap-1.5 h-11 px-3 rounded-md border border-ink-300 dark:border-ink-700 text-sm font-medium whitespace-nowrap hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
      >
        <span class="i-lucide-download text-base" aria-hidden="true"></span>
        <span class="hidden sm:inline xl:hidden">{t('cta.instalar_app')}</span>
      </a>
      <a
        href="https://app.firmar.ec/"
        data-cta="abrir_app"
        class="hidden sm:inline-flex items-center gap-1.5 h-11 px-3 sm:px-3.5 rounded-md bg-brand-500 text-white text-sm font-semibold whitespace-nowrap shadow-[0_4px_16px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_50%,transparent)] ring-1 ring-brand-600/30 hover:shadow-[0_8px_24px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_60%,transparent)] hover:-translate-y-px transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
      >
        <span>{t('cta.abrir_app')}</span>
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
      <LangSwitch />
      <ThemeToggle
        client:idle
        labelToggle={t('theme.toggle')}
        labelLight={t('theme.light')}
        labelDark={t('theme.dark')}
      />
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-md text-ink-700 dark:text-ink-200 hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
        aria-label={t('nav.menu')}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span id="mobile-menu-icon" class="i-lucide-menu text-xl" aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile nav panel — revealed by the hamburger below md. -->
  <div
    id="mobile-menu"
    class="md:hidden absolute left-0 right-0 top-full origin-top border-b border-ink-200/70 dark:border-ink-800/70 bg-ink-50/95 dark:bg-ink-950/95 backdrop-blur-md invisible pointer-events-none opacity-0 -translate-y-2 transition-[opacity,transform,visibility] duration-200 ease-out motion-reduce:transition-none"
  >
    <ul class="container flex flex-col py-3 text-base font-medium">
      {navLinks.map((link) => (
        <li>
          <a
            class="flex items-center px-3 py-3 rounded-md hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
            href={link.href}
            data-mobile-link
          >{link.label}</a>
        </li>
      ))}
      <li class="pt-1">
        <a
          href={buyUrl}
          data-cta="comprar_certificado"
          data-mobile-link
          class="flex items-center justify-center gap-2 h-12 px-3 rounded-md font-semibold shadow-sm hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          style="background:#C9821E;color:#11201a"
        >
          <span class="i-lucide-shopping-bag text-base" aria-hidden="true"></span>
          <span>{lang === 'es' ? 'Comprar certificado' : 'Get a certificate'}</span>
        </a>
      </li>
      <li class="pt-1">
        <a
          href="https://app.firmar.ec/"
          data-cta="abrir_app"
          class="flex items-center justify-center gap-1.5 h-12 px-3 rounded-md bg-brand-500 text-white font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          data-mobile-link
        >
          <span>{t('cta.abrir_app')}</span>
          <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
        </a>
      </li>
      <li class="pt-1">
        <a
          href="https://app.firmar.ec/?install=1"
          data-cta="instalar_app"
          class="flex items-center justify-center gap-1.5 h-12 px-3 rounded-md border border-ink-300 dark:border-ink-700 font-medium hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          data-mobile-link
        >
          <span class="i-lucide-download text-base" aria-hidden="true"></span>
          <span>{t('cta.instalar_app')}</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var h = document.getElementById('site-header');
    if (!h) return;
    function update() {
      h.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();

  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var panel = document.getElementById('mobile-menu');
    var icon = document.getElementById('mobile-menu-icon');
    if (!btn || !panel || !icon) return;

    var OPEN = ['visible', 'pointer-events-auto', 'opacity-100', 'translate-y-0'];
    var CLOSED = ['invisible', 'pointer-events-none', 'opacity-0', '-translate-y-2'];

    function setOpen(open) {
      panel.classList.remove.apply(panel.classList, open ? CLOSED : OPEN);
      panel.classList.add.apply(panel.classList, open ? OPEN : CLOSED);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      icon.className = (open ? 'i-lucide-x' : 'i-lucide-menu') + ' text-xl';
    }

    btn.addEventListener('click', function () {
      setOpen(btn.getAttribute('aria-expanded') !== 'true');
    });
    // Close on link tap, Escape, click-outside, and when crossing to desktop.
    panel.querySelectorAll('[data-mobile-link]').forEach(function (a) {
      a.addEventListener('click', function () { setOpen(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    document.addEventListener('click', function (e) {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      if (!panel.contains(e.target) && !btn.contains(e.target)) setOpen(false);
    });
    var mq = window.matchMedia('(min-width: 768px)');
    var onChange = function () { if (mq.matches) setOpen(false); };
    if (mq.addEventListener) mq.addEventListener('change', onChange);
    else mq.addListener(onChange);
  })();
</script>

<style>
  #site-header[data-scrolled="true"] {
    box-shadow: 0 1px 0 0 var(--ink-200);
  }
  [data-theme="dark"] #site-header[data-scrolled="true"] {
    box-shadow: 0 1px 0 0 var(--ink-800);
  }
</style>
