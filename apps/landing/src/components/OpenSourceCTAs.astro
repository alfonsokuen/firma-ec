---
import { SITE } from '../lib/jsonld.ts';
import { getLangFromUrl } from '../i18n/utils.ts';

const lang = getLangFromUrl(Astro.url);

const repos = [
  { url: SITE.githubOrg, label: 'github.com/idkmanager/firma-ec', kind: lang === 'es' ? 'Mirror público OSS oficial' : 'Official public OSS mirror' },
  { url: SITE.githubPersonal, label: 'github.com/alfonsokuen/firma-ec', kind: lang === 'es' ? 'Mirror público portafolio personal' : 'Personal portfolio public mirror' },
  { url: SITE.sourceCodeRepository, label: 'git.idkmanager.com/alfonso/firma-ec', kind: lang === 'es' ? 'Repositorio primario (Gitea)' : 'Primary repository (Gitea)' },
];
---
<section class="container py-12 md:py-16" aria-labelledby="oss-title">
  <header class="max-w-2xl mb-10">
    <p class="text-sm font-mono text-brand-500 mb-2 uppercase tracking-wider">
      {lang === 'es' ? 'Open source' : 'Open source'}
    </p>
    <h2 id="oss-title" class="mb-3">
      {lang === 'es' ? 'Audita el código tú mismo.' : 'Audit the code yourself.'}
    </h2>
    <p class="text-ink-600 dark:text-ink-300">
      {lang === 'es'
        ? 'Apache 2.0. Reproducible builds verificables. Releases firmadas con Sigstore Cosign + transparency log Rekor + SLSA L3 provenance.'
        : 'Apache 2.0. Verifiable reproducible builds. Releases signed with Sigstore Cosign + Rekor transparency log + SLSA L3 provenance.'}
    </p>
  </header>
  <ul class="grid gap-3 md:grid-cols-3">
    {repos.map((r) => (
      <li class="rounded-lg border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-5 hover:border-brand-400 transition-colors">
        <p class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-2">{r.kind}</p>
        <a href={r.url} class="font-mono text-sm text-brand-500 hover:underline break-all">{r.label}</a>
        <p class="mt-3 text-xs text-ink-500 inline-flex items-center gap-1">
          <span class="i-lucide-external-link" aria-hidden="true"></span>
          {lang === 'es' ? 'Abrir repositorio' : 'Open repository'}
        </p>
      </li>
    ))}
  </ul>
</section>
