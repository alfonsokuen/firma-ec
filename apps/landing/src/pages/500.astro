---
import { getLangFromUrl, localizedUrl } from '../i18n/utils.ts';
import Base from '../layouts/Base.astro';

const lang = getLangFromUrl(Astro.url);
const home = localizedUrl('home', lang);
const title = lang === 'es' ? 'Error del servidor (500)' : 'Server error (500)';
const description =
  lang === 'es'
    ? 'Algo salió mal de nuestro lado. Inténtalo nuevamente en un momento.'
    : 'Something went wrong on our side. Try again in a moment.';
---
<Base title={title} description={description} routeKey="home" noindex={true}>
  <section class="container py-16 md:py-24 text-center">
    <p class="font-mono text-sm uppercase tracking-wider text-err-500 mb-4">500</p>
    <h1 class="mb-4">{title}</h1>
    <p class="text-ink-600 dark:text-ink-300 max-w-prose mx-auto mb-8">{description}</p>
    <p class="text-sm text-ink-500 mb-8">
      {lang === 'es' ? 'Si el problema persiste, ' : 'If the problem persists, '}
      <a class="text-brand-500 underline" href="https://github.com/idkmanager/firmar-ec/issues" rel="noopener">
        {lang === 'es' ? 'abre un issue en GitHub' : 'open an issue on GitHub'}
      </a>.
    </p>
    <a href={home} class="inline-flex items-center gap-2 px-5 py-3 rounded-md bg-brand-500 text-white font-medium hover:bg-brand-600 transition-colors min-h-11">
      {lang === 'es' ? 'Ir al inicio' : 'Go home'}
    </a>
  </section>
</Base>
