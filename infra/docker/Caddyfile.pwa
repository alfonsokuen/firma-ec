{
  auto_https off
  admin off
  servers {
    protocols h1 h2 h3
    timeouts {
      read_body 10s
      read_header 5s
      write 10s
      idle 30s
    }
  }
}

:8080 {
  root * /srv
  encode zstd gzip
  file_server {
    precompressed br gzip
  }

  # ──────────────────────────────────────────────────────────────────────────
  # Security headers — strict for app.firmar.ec (PWA, in-browser crypto)
  # ──────────────────────────────────────────────────────────────────────────
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # CSP rationale:
    # - 'wasm-unsafe-eval' enables WebCrypto-adjacent WASM (asn1js/pkijs paths if used).
    # - connect-src includes ocsp.firmar.ec for live OCSP queries via the CF Worker proxy.
    # - connect-src includes freetsa.org (F6) for the default RFC 3161 TSA round-trip.
    #   Power users that point /configuracion at a self-hosted TSA (e.g. ARCOTEL
    #   when accredited endpoints publish RFC 3161) MUST also widen this CSP at
    #   deploy time — Configuracion.svelte surfaces a warn-tier hint when the URL
    #   diverges from the default. We deliberately do NOT use connect-src https:
    #   wildcard: keeping the allowlist explicit preserves the SSL-Labs A+ posture.
    # - worker-src 'self' blob: allows the verify Web Worker (chunked ES module).
    # - require-trusted-types-for 'script' hardens against DOM XSS sinks.
    # - form-action 'self' is intentional (PWA may post to its own routes).
    # script-src 'unsafe-inline' is required for the Trusted Types default policy
    # bootstrap script (hotfix v0.2.1). TODO: replace with sha256-* hash once Vite
    # build pipeline emits a stable inline-script digest. Trusted Types still
    # restricts script-URL sinks (createScriptURL) — XSS surface stays minimal.
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://ocsp.firmar.ec https://freetsa.org; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'"

    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"

    # Permissions-Policy — landing baseline + extra sensor/feature lockdown.
    # Anything that could leak side-channel data on a crypto surface is denied.
    # v0.4.0 — web-share=(self) re-enabled so the PWA can act as a Share Target
    # and use navigator.share() for the "Share signed PDF" CTA on /firmar.
    # All other intrusive sensors stay denied.
    Permissions-Policy "accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), usb=(), web-share=(self), window-management=(), xr-spatial-tracking=()"

    Cross-Origin-Opener-Policy "same-origin"
    # F6: relaxed from require-corp → credentialless so the FreeTSA RFC 3161
    # round-trip (which doesn't ship CORP/CORS headers) is not blocked by COEP.
    # We don't use SharedArrayBuffer in production code paths, only defensive
    # type casts; cross-origin isolation guarantee is reduced but acceptable
    # given the TSA fetch happens with no credentials and is opaque to JS
    # cross-origin (response is parsed as binary CMS bytes).
    Cross-Origin-Embedder-Policy "credentialless"
    Cross-Origin-Resource-Policy "same-origin"

    # Allow the SW to control the entire origin from /sw.js.
    Service-Worker-Allowed "/"

    X-Robots-Tag "noindex, nofollow"
    -Server
  }

  # ──────────────────────────────────────────────────────────────────────────
  # Cache policy
  # ──────────────────────────────────────────────────────────────────────────
  # Hashed Vite assets (8+ hex chars before extension) — immutable for 1y.
  @hashed path_regexp ^/assets/.*-[A-Za-z0-9_-]{8,}\.(js|css|woff2|svg|png|jpg|webp|avif|map)$
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  # Service Worker + Workbox runtime: must always revalidate, never stale.
  @sw path /sw.js /workbox-*.js /registerSW.js
  header @sw Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

  # Trust list: must always be fresh (security-critical, revocation list).
  @trust path /trust/tsl-ec.json /trust/tsl-ec.sha256
  header @trust Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

  # PWA manifest: short cache, allow updates.
  @manifest path /manifest.webmanifest
  header @manifest Cache-Control "public, max-age=3600, must-revalidate"

  # index.html and SPA fallback root: no-cache (must always check for updates).
  @html path *.html /
  header @html Cache-Control "no-cache, must-revalidate"

  # SPA fallback for client-side routes (Verificar, Firmar, Paranoia, etc.)
  try_files {path} /index.html

  handle_errors {
    respond "{err.status_code}" {err.status_code}
  }
}
