---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../layouts/ArticleSeo.astro';
import { howTo } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/firmar-documentos-en-linea');
if (!entry) throw new Error('Missing content/pages/es/firmar-documentos-en-linea.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT2M',
  steps: [
    { name: 'Abre la app', text: 'Visita app.firmar.ec en tu navegador, desde computadora o móvil.', url: 'https://app.firmar.ec/' },
    { name: 'Carga el documento PDF', text: 'Arrastra o selecciona el documento que quieres firmar; nunca sale de tu equipo.' },
    { name: 'Carga tu certificado .p12 y firma', text: 'Ingresa la contraseña, coloca el sello visible y confirma. La firma PAdES se calcula en tu navegador.' },
    { name: 'Descarga el PDF firmado', text: 'El documento queda firmado con PAdES (ETSI EN 319 142), válido ante SRI, banca e instituciones públicas.' },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'firmar-documentos-en-linea',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
