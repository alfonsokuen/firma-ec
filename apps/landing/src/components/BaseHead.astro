---
import '../styles/fonts.css';
import '../styles/tokens.css';
import { SITE } from '../lib/jsonld.ts';
import Analytics from './Analytics.astro';
import seoMetaOverrides from '../data/seo-meta.json';

/** Seam de meta SEO (mismo patrón ya construido y probado en producción para
 *  idkmanager-web/src/components/SEO.astro): mapa `ruta → { title?, description? }`
 *  que el motor de remediación SEO edita por PR. Arranca vacío (`{}`): sin
 *  entradas, este seam es un no-op absoluto y la página se comporta
 *  exactamente como antes.
 *
 *  El override GANA sobre las props `title`/`description` que pasa cada
 *  página: si perdiera, un fix auto-mergeado aterrizaría sin efecto
 *  observable — un fallo silencioso ya visto en este mismo patrón. */
interface SeoMetaOverride {
  title?: string;
  description?: string;
}

/** Normaliza para que `/servicios` y `/servicios/` sean la misma clave. Este
 *  sitio sirve con `trailingSlash: 'always'` (astro.config.mjs) y formato
 *  `directory`, así que `Astro.url.pathname` trae la barra final en build —
 *  pero sin normalizar en AMBOS lados (al escribir la clave del JSON y al
 *  leerla aquí) el seam nunca aplicaría, y el fallo sería mudo. La raíz se
 *  conserva como "/".
 */
function normalizeRoute(pathname: string): string {
  const trimmed = pathname.replace(/\/+$/, '');
  return trimmed.length === 0 ? '/' : trimmed;
}

/** Normaliza también las CLAVES del propio seam al cargarlo. El motor de
 *  remediación deriva las claves de las URLs reales del sitio (sitemap, GSC),
 *  que llevan barra final (`trailingSlash: 'always'`) -- si el mapa no se
 *  normaliza aquí, una clave con barra ("/faq/") nunca haría match contra el
 *  pathname ya normalizado, y el override se ignoraría sin ningún log. */
const normalizedSeoMetaOverrides: Record<string, SeoMetaOverride> = Object.fromEntries(
  Object.entries(seoMetaOverrides as Record<string, SeoMetaOverride>).map(([route, override]) => [
    normalizeRoute(route),
    override,
  ]),
);

interface Props {
  title: string;
  description: string;
  canonical?: string;
  lang?: 'es' | 'en';
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  hreflangs?: { es?: string; en?: string };
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  lang = 'es',
  ogImage = '/og-firmar-ec.png',
  ogType = 'website',
  jsonld = [],
  hreflangs = {},
  noindex = false,
} = Astro.props;

// El seam GANA sobre la prop de la página — ver comentario del import arriba.
const routeOverride: SeoMetaOverride =
  normalizedSeoMetaOverrides[normalizeRoute(Astro.url.pathname)] ?? {};
const effectiveTitle = routeOverride.title ?? title;
const effectiveDescription = routeOverride.description ?? description;

const fullTitle = effectiveTitle.includes(SITE.name) ? effectiveTitle : `${effectiveTitle} — ${SITE.name}`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="oklch(58% 0.21 245)" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="oklch(8% 0.03 250)" media="(prefers-color-scheme: dark)" />
<title>{fullTitle}</title>
<meta name="description" content={effectiveDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

{hreflangs.es && <link rel="alternate" hreflang="es-EC" href={hreflangs.es} />}
{hreflangs.en && <link rel="alternate" hreflang="en-US" href={hreflangs.en} />}
{(hreflangs.es || hreflangs.en) && <link rel="alternate" hreflang="x-default" href={hreflangs.es ?? hreflangs.en} />}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={effectiveDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={lang === 'es' ? 'es_EC' : 'en_US'} />
<meta property="og:image" content={new URL(ogImage, SITE.url).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={effectiveDescription} />
<meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

<link rel="preload" href="/fonts/Geist-Display-700.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/Geist-Sans-400.woff2" as="font" type="font/woff2" crossorigin />

<link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{jsonld.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}

<Analytics />
