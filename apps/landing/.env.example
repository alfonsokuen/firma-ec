# firmar.ec landing — build-time public env.
# Astro inlines PUBLIC_* into the STATIC build, so these take effect at build time
# (locally via `pnpm --filter @firma-ec/landing build`, or in CI/deploy via the
# Docker build args wired in infra/docker/landing.Dockerfile).
#
# MEASUREMENT IS INERT BY DEFAULT: with these unset the build emits byte-identical
# HTML and the "sin tracking · LOPDP por diseño" promise holds. Set them only when
# measurement is deliberately turned on. See docs/marketing/social/medicion.md.

# Cloudflare Web Analytics token (cookieless, no PII, no fingerprinting).
# Already allowed by the landing CSP (Caddyfile.landing → static.cloudflareinsights.com).
# Get it in Cloudflare dashboard → Web Analytics → firmar.ec → JS snippet token.
# Empty = disabled.
PUBLIC_CF_BEACON_TOKEN=

# Same-origin endpoint that receives aggregate conversion-event beacons (no PII, no cookies).
# MUST be same-origin to satisfy the CSP (connect-src 'self'), e.g. /api/stats/event.
# Empty = no beacons (the in-page dataLayer still works for a tag manager / CF Zaraz).
PUBLIC_EVENTS_ENDPOINT=

# Base URL of the usage-stats API consumed by the home counter / dashboard (already in use).
# Defaults to same-origin /api when unset.
# PUBLIC_STATS_API_BASE=
