---
import { getLangFromUrl } from '../i18n/utils.ts';
import { SITE } from '../lib/jsonld.ts';

const lang = getLangFromUrl(Astro.url);
---
<section class="container py-12 md:py-16" aria-labelledby="operado-title">
  <div class="rounded-xl border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-8 md:p-10 max-w-3xl">
    <p class="text-sm font-mono text-ink-500 mb-2 uppercase tracking-wider">
      {lang === 'es' ? 'Operado por' : 'Operated by'}
    </p>
    <h2 id="operado-title" class="mb-3">
      <a href={SITE.operatorUrl} class="inline-block hover:opacity-80 transition-opacity" aria-label="IDK Manager">
        <img
          src="/brand/idk-manager-wordmark.png"
          srcset="/brand/idk-manager-wordmark.png 1x, /brand/idk-manager-wordmark@2x.png 2x"
          width="160"
          height="66"
          alt="IDK Manager"
          class="h-10 md:h-12 w-auto"
          loading="lazy"
          decoding="async"
        />
        <span class="sr-only">IDK Manager</span>
      </a>
    </h2>
    <p class="text-ink-600 dark:text-ink-300 max-w-2xl">
      {lang === 'es'
        ? 'firmar.ec es un proyecto open-source sin fines de lucro de IDK Manager, taller de software y servicios técnicos en Quito, Ecuador. Construimos y mantenemos esta herramienta como contribución al ecosistema digital ecuatoriano. No cobramos por el servicio. No hay plan premium. No hay tracking.'
        : 'firmar.ec is an open-source non-profit project by IDK Manager, a software studio and technical services workshop in Quito, Ecuador. We build and maintain this tool as a contribution to the Ecuadorian digital ecosystem. No charges. No premium tier. No tracking.'}
    </p>
    <p class="mt-4 text-sm text-ink-500">
      {lang === 'es' ? 'Contacto:' : 'Contact:'} <a class="text-brand-500 hover:underline" href={SITE.contactUrl} rel="noopener">GitHub Issues</a>
      · {lang === 'es' ? 'Datos personales' : 'Personal data'}: <a class="text-brand-500 hover:underline" href={SITE.dpoContactUrl} rel="noopener">idkmanager.com</a>
      · {lang === 'es' ? 'Seguridad' : 'Security'}: <a class="text-brand-500 hover:underline" href={SITE.securityUrl} rel="noopener">{lang === 'es' ? 'Advisory privado' : 'Private advisory'}</a>
    </p>
  </div>
</section>
