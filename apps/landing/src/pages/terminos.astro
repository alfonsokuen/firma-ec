---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE, legalDocument } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/terminos');
if (!entry) throw new Error('Missing content/pages/es/terminos.md');
const { Content } = await render(entry);
const data = entry.data;

const pageProps = {
  title: data.title,
  description: data.description,
  routeKey: 'terminos' as const,
  breadcrumbs: data.breadcrumbs,
  ...(data.h1 !== undefined ? { h1: data.h1 } : {}),
};
---
<Page {...pageProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(legalDocument({ lang: 'es', type: 'TermsOfService', url: `${SITE.url}/terminos` }))}></script>
</Page>
