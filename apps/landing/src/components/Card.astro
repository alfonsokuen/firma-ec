---
interface Props {
  as?: 'div' | 'article' | 'li';
  icon?: string;
  title?: string;
  eyebrow?: string;
  href?: string;
}
const { as: Tag = 'div', icon, title, eyebrow, href } = Astro.props;
const interactive = Boolean(href);
---
<Tag class={`group relative rounded-lg border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-6 ${interactive ? 'hover:border-brand-400 transition-colors' : ''}`}>
  {icon && (
    <div class="w-10 h-10 rounded-md bg-brand-500/10 flex items-center justify-center mb-4">
      <span class={`${icon} text-xl text-brand-500`} aria-hidden="true"></span>
    </div>
  )}
  {eyebrow && <p class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-2">{eyebrow}</p>}
  {title && (
    href
      ? <h3 class="text-lg font-semibold mb-2"><a class="before:absolute before:inset-0" {...{ href }}>{title}</a></h3>
      : <h3 class="text-lg font-semibold mb-2">{title}</h3>
  )}
  <slot />
</Tag>
