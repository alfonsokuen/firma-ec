---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../../layouts/ArticleSeo.astro';
import { howTo } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/how-to-sign-with-bce-certificate');
if (!entry) throw new Error('Missing content/pages/en/how-to-sign-with-bce-certificate.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT3M',
  steps: [
    {
      name: 'Load the PDF',
      text: 'Drag or select the PDF you want to sign at app.firmar.ec/firmar.',
      url: 'https://app.firmar.ec/firmar',
    },
    {
      name: 'Place the signature box',
      text: 'Position and resize the visible stamp (with verification QR code) over the document.',
    },
    {
      name: 'Load your .p12 certificate',
      text: 'The app validates that it is from an ARCOTEL-accredited Ecuadorian ECI and that it is current.',
    },
    {
      name: 'Enter the password',
      text: 'Used only to import the key into your browser and erased immediately; never sent to any server.',
    },
    {
      name: 'Review and sign',
      text: 'The signature is computed in a dedicated Web Worker inside your browser.',
    },
    { name: 'Download the signed PDF', text: 'The resulting file is PAdES, fully valid.' },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'como-firmar-con-certificado-bce',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
