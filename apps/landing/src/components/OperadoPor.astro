---
import { getLangFromUrl } from '../i18n/utils.ts';
import { SITE } from '../lib/jsonld.ts';

const lang = getLangFromUrl(Astro.url);
---
<section class="container py-16 md:py-24" aria-labelledby="operado-title">
  <div class="max-w-3xl mx-auto rounded-[1.25rem] bg-ink-900/4 dark:bg-white/6 p-1.5 ring-1 ring-ink-900/6 dark:ring-white/10" data-reveal>
  <div class="rounded-[calc(1.25rem-0.375rem)] border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-8 md:p-10 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.55)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
    <p class="text-sm font-mono text-ink-500 mb-2 uppercase tracking-wider">
      {lang === 'es' ? 'Operado por' : 'Operated by'}
    </p>
    <h2 id="operado-title" class="mb-3">
      <a href={SITE.operatorUrl} class="inline-block hover:opacity-80 transition-opacity">
        <img
          src="/brand/idkmanager-logo.png"
          srcset="/brand/idkmanager-logo.png 1x, /brand/idkmanager-logo@2x.png 2x"
          width="351"
          height="60"
          alt="IDKMANAGER"
          class="h-8 md:h-9 w-auto max-w-full"
          loading="lazy"
          decoding="async"
        />
      </a>
    </h2>
    <p class="text-ink-600 dark:text-ink-300 max-w-2xl mx-auto">
      {lang === 'es'
        ? 'firmar.ec es un proyecto open-source sin fines de lucro de IDK Manager, taller de software y servicios técnicos en Quito, Ecuador. Construimos y mantenemos esta herramienta como contribución al ecosistema digital ecuatoriano. No cobramos por el servicio. No hay plan premium. No hay tracking.'
        : 'firmar.ec is an open-source non-profit project by IDK Manager, a software studio and technical services workshop in Quito, Ecuador. We build and maintain this tool as a contribution to the Ecuadorian digital ecosystem. No charges. No premium tier. No tracking.'}
    </p>
    <p class="mt-4 text-sm text-ink-500">
      {lang === 'es' ? 'Contacto:' : 'Contact:'} <a class="text-brand-500 underline" href={SITE.contactUrl} rel="noopener">GitHub Issues</a>
      · {lang === 'es' ? 'Datos personales' : 'Personal data'}: <a class="text-brand-500 underline" href={SITE.dpoContactUrl} rel="noopener">idkmanager.com</a>
      · {lang === 'es' ? 'Seguridad' : 'Security'}: <a class="text-brand-500 underline" href={SITE.securityUrl} rel="noopener">{lang === 'es' ? 'Advisory privado' : 'Private advisory'}</a>
    </p>
  </div>
  </div>
</section>
