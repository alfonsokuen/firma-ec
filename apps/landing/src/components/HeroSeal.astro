---
import { getLangFromUrl } from '../i18n/utils.ts';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

// Sello de certificación del hero: escudo con check ámbar + chip .p12 al centro,
// rodeado de un anillo de texto que gira MUY lento (60s/vuelta) — on-brand con
// "firma acreditada". Todo CSS/SVG (0 KB de imagen, CSP-safe), decorativo
// (aria-hidden), rotación solo por transform (GPU) y detenida en reduced-motion
// (además del guard global de tokens.css). La rotación vive en un <div> HTML,
// nunca en un <g> del SVG, para evitar los quirks de transform-origin en Safari.
const ring = es
  ? 'FIRMA ELECTRÓNICA · ECUADOR · SEGURA · '
  : 'ELECTRONIC SIGNATURE · ECUADOR · SECURE · ';
// Circunferencia del path del anillo (r=84 en el viewBox 200): 2·π·84 ≈ 527.
const ORBIT_LEN = 527;
---
<div class="seal relative aspect-square w-[clamp(13rem,20vw,16.5rem)] mx-auto" aria-hidden="true">
  <!-- Halo tenue detrás del sello (marca + ámbar), contenido dentro del cuadro. -->
  <div class="seal-halo absolute inset-[-14%] -z-10"></div>

  <!-- Capa que GIRA: anillo de texto + círculo punteado. -->
  <div class="seal-ring absolute inset-0">
    <svg viewBox="0 0 200 200" class="size-full">
      <defs>
        <path id="seal-orbit" d="M100,16 a84,84 0 1,1 -0.001,0" />
      </defs>
      <circle
        class="seal-dash"
        cx="100"
        cy="100"
        r="70"
        fill="none"
        stroke-width="1"
        stroke-dasharray="2 6"
      />
      <text class="seal-text" font-size="10.5" letter-spacing="2.4">
        <textPath href="#seal-orbit" textLength={ORBIT_LEN} lengthAdjust="spacing">{ring}{ring}</textPath>
      </text>
    </svg>
  </div>

  <!-- Núcleo estático: escudo + check ámbar + chip .p12 (mismo lenguaje del hero). -->
  <div
    class="absolute inset-[19%] flex flex-col items-center justify-center gap-2 rounded-full border border-ink-200 bg-white shadow-[0_24px_48px_-20px_color-mix(in_oklch,var(--brand-500)_35%,transparent)] dark:border-ink-700 dark:bg-ink-900"
  >
    <span class="i-lucide-shield-check text-[3.25rem] lt-md:text-[2.75rem]" style="color:#C9821E"></span>
    <span
      class="inline-flex items-center rounded-md border border-ink-200 bg-ink-100 px-2 py-0.5 align-middle font-mono text-xs font-medium text-brand-600 dark:border-ink-700 dark:bg-ink-800 dark:text-brand-400"
    >.p12</span>
  </div>
</div>

<style>
  /* Rotación continua y sutil: solo transform, capa compuesta propia. El guard
     global de reduced-motion (tokens.css) ya la neutraliza; el bloque de abajo
     lo deja explícito. */
  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .seal-ring {
    animation: seal-spin 60s linear infinite;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .seal-text {
    fill: var(--ink-500);
    font-family: var(--font-mono);
    text-transform: uppercase;
  }
  .seal-dash {
    stroke: color-mix(in oklch, var(--brand-500) 32%, transparent);
  }
  [data-theme='dark'] .seal-text {
    fill: var(--ink-400);
  }
  [data-theme='dark'] .seal-dash {
    stroke: color-mix(in oklch, var(--brand-400) 40%, transparent);
  }

  /* Halo: glow de marca + toque ámbar, muy tenue, muere antes del borde. */
  .seal-halo {
    border-radius: 9999px;
    background:
      radial-gradient(50% 50% at 50% 45%, color-mix(in oklch, var(--brand-500) 14%, transparent) 0%, transparent 70%),
      radial-gradient(42% 42% at 62% 68%, color-mix(in oklch, #c9821e 10%, transparent) 0%, transparent 68%);
  }
  [data-theme='dark'] .seal-halo {
    background:
      radial-gradient(50% 50% at 50% 45%, color-mix(in oklch, var(--brand-400) 18%, transparent) 0%, transparent 70%),
      radial-gradient(42% 42% at 62% 68%, color-mix(in oklch, #c9821e 12%, transparent) 0%, transparent 68%);
  }

  @media (prefers-reduced-motion: reduce) {
    .seal-ring {
      animation: none;
    }
  }
</style>
