---
import { getLangFromUrl } from '../i18n/utils.ts';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

// Escena central del hero: un documento dentro de un marco de navegador
// (double-bezel) donde la firma manuscrita se dibuja sola, luego aparece el
// sello ámbar con QR y por último el chip verde "Firma válida". Todo CSS/SVG
// puro (0 KB de imagen, transform/opacity/stroke-dashoffset), decorativo
// (`aria-hidden`), y estático-final con prefers-reduced-motion.
---
<div class="scene relative mx-auto mt-2 lt-md:mt-3 max-w-3xl" aria-hidden="true" data-reveal style="--reveal-delay:150ms">
  <!-- Glow ambiental tras el marco: azul de marca + ámbar, contenidos dentro
       del alto del propio deco (si tocan el borde se ven como rectángulo). -->
  <!-- inset-x-0 en móvil: con -inset-x-10 el glow desbordaba el viewport (24px de hscroll). -->
  <div class="scene-glow pointer-events-none absolute inset-x-0 md:-inset-x-10 -top-10 -bottom-6 -z-10"></div>

  <!-- Double-bezel: shell exterior + marco de navegador interior. -->
  <div class="rounded-[1.4rem] bg-ink-900/4 dark:bg-white/6 p-1.5 ring-1 ring-ink-900/6 dark:ring-white/10 shadow-[0_32px_64px_-24px_color-mix(in_oklch,var(--ink-900)_28%,transparent)]">
    <div class="overflow-hidden rounded-[calc(1.4rem-0.375rem)] border border-ink-200 dark:border-ink-800 bg-white dark:bg-ink-900 shadow-[inset_0_1px_0_rgba(255,255,255,0.55)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]">
      <!-- Barra de navegador: puntos + píldora de URL real. -->
      <div class="flex items-center gap-3 border-b border-ink-100 dark:border-ink-800 bg-ink-50 dark:bg-ink-950/60 px-4 py-2.5">
        <div class="flex items-center gap-1.5">
          <span class="size-2.5 rounded-full bg-ink-200 dark:bg-ink-700"></span>
          <span class="size-2.5 rounded-full bg-ink-200 dark:bg-ink-700"></span>
          <span class="size-2.5 rounded-full bg-ink-200 dark:bg-ink-700"></span>
        </div>
        <div class="mx-auto flex items-center gap-1.5 rounded-full border border-ink-200 dark:border-ink-700 bg-white dark:bg-ink-900 px-3.5 py-1 font-mono text-[0.68rem] text-ink-500 dark:text-ink-400">
          <span class="i-lucide-lock text-[0.65rem] text-ok-500"></span>
          app.firmar.ec
        </div>
        <span class="i-lucide-download text-sm text-ink-300 dark:text-ink-600"></span>
      </div>

      <!-- Lienzo del documento (papel: claro también en dark, como un PDF real). -->
      <div class="relative bg-white px-8 pt-7 pb-6 md:px-12 md:pt-9 md:pb-8 lt-md:px-5">
        <p class="m-0 mb-1 font-display text-[0.8rem] md:text-sm font-bold tracking-[0.04em] text-ink-800 uppercase">
          {es ? 'Contrato de prestación de servicios' : 'Service agreement'}
        </p>
        <p class="m-0 mb-4 font-mono text-[0.58rem] md:text-[0.65rem] text-ink-400">contrato-servicios-2026.pdf · 2/2</p>
        <div class="space-y-2 md:space-y-2.5">
          <div class="h-1.5 w-full rounded-full bg-ink-100"></div>
          <div class="h-1.5 w-11/12 rounded-full bg-ink-100"></div>
          <div class="h-1.5 w-full rounded-full bg-ink-100"></div>
          <div class="h-1.5 w-3/5 rounded-full bg-ink-100"></div>
          <div class="h-1.5 w-4/5 rounded-full bg-ink-100 lt-md:hidden"></div>
          <div class="h-1.5 w-2/5 rounded-full bg-ink-100 lt-md:hidden"></div>
        </div>

        <!-- Zona de firma: rúbrica que se dibuja + sello ámbar con QR. -->
        <div class="mt-6 md:mt-7 flex items-end justify-between gap-5 lt-md:gap-3">
          <div class="min-w-0">
            <svg class="block h-12 w-40 md:h-14 md:w-48" viewBox="0 0 190 56" fill="none">
              <path
                class="scene-signature"
                d="M8 42 C 18 14, 30 10, 32 24 C 33 33, 24 44, 36 36 C 46 29, 47 16, 56 22 C 62 26, 60 36, 70 30 C 78 25, 78 18, 88 20 C 98 22, 96 34, 108 28 C 118 23, 124 24, 132 26 C 142 29, 152 24, 162 22 C 172 20, 178 24, 184 22"
                stroke="#1c2f45"
                stroke-width="2.4"
                stroke-linecap="round"
                pathLength="100"
              />
            </svg>
            <div class="h-px w-44 md:w-52 bg-ink-300"></div>
            <p class="m-0 mt-1.5 text-[0.62rem] md:text-[0.7rem] font-medium text-ink-500">María F. Cárdenas</p>
          </div>
          <div class="scene-stamp shrink-0 flex items-center gap-2.5 rounded-md border-2 border-[#C9821E]/60 bg-[#C9821E]/[0.06] p-2.5 md:p-3">
            <span class="i-lucide-qr-code text-2xl md:text-3xl text-ink-700 shrink-0"></span>
            <div class="min-w-0 space-y-1.5 lt-md:hidden">
              <div class="h-1.5 w-20 rounded-full bg-[#C9821E]/70"></div>
              <div class="h-1 w-14 rounded-full bg-ink-300"></div>
              <div class="h-1 w-16 rounded-full bg-ink-200"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Chip de veredicto: aparece al final de la secuencia, solapado al marco. -->
  <div class="scene-chip absolute -bottom-3.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 rounded-full bg-ok-500 px-3.5 py-1.5 text-xs md:text-sm font-semibold text-white shadow-[0_10px_24px_-8px_color-mix(in_oklch,oklch(60%_0.15_155)_70%,transparent)] ring-2 ring-white dark:ring-ink-950">
    <span class="i-lucide-badge-check text-sm md:text-base"></span>
    {es ? 'Firma válida' : 'Valid signature'}
  </div>
</div>

<style>
  /* Secuencia: la rúbrica se dibuja (0.6s→2s), el sello aparece (2.1s) y el
     chip verde remata (2.7s). Solo stroke-dashoffset / opacity / transform. */
  @keyframes scene-sign {
    from { stroke-dashoffset: 100; }
    to { stroke-dashoffset: 0; }
  }
  .scene-signature {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: scene-sign 1400ms cubic-bezier(0.45, 0, 0.55, 1) 600ms forwards;
  }
  @keyframes scene-pop {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }
  .scene-stamp {
    opacity: 0;
    transform: scale(0.9);
    animation: scene-pop 450ms cubic-bezier(0.23, 1, 0.32, 1) 2100ms forwards;
  }
  .scene-chip {
    opacity: 0;
    /* transform de reposo incluye el centrado horizontal */
    transform: translateX(-50%) scale(0.9);
    animation: scene-chip-pop 450ms cubic-bezier(0.23, 1, 0.32, 1) 2700ms forwards;
  }
  @keyframes scene-chip-pop {
    from { opacity: 0; transform: translateX(-50%) scale(0.9); }
    to { opacity: 1; transform: translateX(-50%) scale(1); }
  }

  .scene-glow {
    background:
      radial-gradient(
        42% 55% at 28% 42%,
        color-mix(in oklch, var(--brand-500) 12%, transparent) 0%,
        transparent 68%
      ),
      radial-gradient(
        36% 48% at 74% 60%,
        color-mix(in oklch, #C9821E 9%, transparent) 0%,
        transparent 66%
      );
  }
  [data-theme="dark"] .scene-glow {
    background:
      radial-gradient(
        42% 55% at 28% 42%,
        color-mix(in oklch, var(--brand-400) 15%, transparent) 0%,
        transparent 68%
      ),
      radial-gradient(
        36% 48% at 74% 60%,
        color-mix(in oklch, #C9821E 11%, transparent) 0%,
        transparent 66%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-signature { animation: none; stroke-dashoffset: 0; }
    .scene-stamp { animation: none; opacity: 1; transform: none; }
    .scene-chip { animation: none; opacity: 1; transform: translateX(-50%); }
  }
</style>
