---
import { getEntry, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { SITE, techArticle } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/seguridad');
if (!entry) throw new Error('Missing content/pages/es/seguridad.md');
const { Content } = await render(entry);
const data = entry.data;

const pageProps = {
  title: data.title,
  description: data.description,
  routeKey: 'seguridad' as const,
  breadcrumbs: data.breadcrumbs,
  ...(data.h1 !== undefined ? { h1: data.h1 } : {}),
};
---
<Page {...pageProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(techArticle({
    headline: data.title,
    description: data.description,
    url: `${SITE.url}/seguridad`,
    lang: 'es',
    datePublished: data.datePublished,
    ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  }))}></script>
</Page>
