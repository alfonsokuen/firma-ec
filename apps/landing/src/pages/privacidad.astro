---
import Page from '../layouts/Page.astro';
import { render, getEntry } from 'astro:content';
import { legalDocument, SITE } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/privacidad');
if (!entry) throw new Error('Missing content/pages/es/privacidad.md');
const { Content } = await render(entry);
const data = entry.data;
---
<Page
  title={data.title}
  description={data.description}
  routeKey="privacidad"
  {..( data.h1 !== undefined && { h1: data.h1 })}
  breadcrumbs={data.breadcrumbs}
>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(legalDocument({ lang: 'es', type: 'PrivacyPolicy', url: `${SITE.url}/privacidad` }))}></script>
</Page>
