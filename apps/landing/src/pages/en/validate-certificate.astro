---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../../layouts/ArticleSeo.astro';
import { howTo } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/validate-certificate');
if (!entry) throw new Error('Missing content/pages/en/validate-certificate.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT1M',
  steps: [
    {
      name: 'Open the validator',
      text: 'Visit app.firmar.ec/validate-certificate in your browser.',
      url: 'https://app.firmar.ec/#/validar-certificado',
    },
    { name: 'Load your .p12 / .pfx', text: 'Drag or select the certificate you received from your ACE.' },
    { name: 'Enter the password', text: 'Type the certificate password. Nothing leaves your device.' },
    {
      name: 'Read the result',
      text: 'Shows holder, ID/RUC, issuing authority (ACE), validity and ARCOTEL trust chain.',
    },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'validar-certificado',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
