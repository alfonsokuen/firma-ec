---
import { getLangFromUrl } from '../i18n/utils.ts';
import Page from '../layouts/Page.astro';
import { SITE } from '../lib/jsonld.ts';

const lang = getLangFromUrl(Astro.url);
const title = lang === 'es' ? 'Contacto' : 'Contact';
const description =
  lang === 'es'
    ? 'Cómo contactar a firmar.ec. Sin formularios JS, sin tracking. Tres canales públicos según la naturaleza de tu mensaje.'
    : 'How to reach firmar.ec. No JS forms, no tracking. Three public channels by nature of your message.';

const channels =
  lang === 'es'
    ? [
        {
          label: 'General / soporte',
          cta: 'Abrir issue en GitHub',
          href: SITE.contactUrl,
          blurb:
            'Dudas de uso, sugerencias, alianzas no comerciales, prensa. Respuesta pública en el repo.',
        },
        {
          label: 'Datos personales (LOPDP)',
          cta: 'Contacto IDK Manager',
          href: SITE.dpoContactUrl,
          blurb:
            'Derechos ARCO+, ejercicio de la LOPDP, consultas regulatorias. El controlador de datos es IDK Manager. Respondemos en 15 días hábiles.',
        },
        {
          label: 'Seguridad (divulgación responsable)',
          cta: 'Reportar advisory privado',
          href: SITE.securityUrl,
          blurb:
            'Reportes de vulnerabilidad vía GitHub Security Advisories (privado, cifrado en tránsito). Política RFC 9116 en /.well-known/security.txt. Respondemos en 48 h.',
        },
      ]
    : [
        {
          label: 'General / support',
          cta: 'Open a GitHub issue',
          href: SITE.contactUrl,
          blurb:
            'Usage questions, suggestions, non-commercial partnerships, press. Public reply on the repo.',
        },
        {
          label: 'Personal data (LOPDP)',
          cta: 'Contact IDK Manager',
          href: SITE.dpoContactUrl,
          blurb:
            'ARCO+ rights, LOPDP exercise, regulatory inquiries. Data controller is IDK Manager. We answer within 15 business days.',
        },
        {
          label: 'Security (responsible disclosure)',
          cta: 'Report a private advisory',
          href: SITE.securityUrl,
          blurb:
            'Vulnerability reports via GitHub Security Advisories (private, encrypted in transit). RFC 9116 policy at /.well-known/security.txt. We answer in 48 h.',
        },
      ];
---
<Page
  title={title}
  description={description}
  routeKey="contacto"
  h1={title}
  breadcrumbs={[{ name: title, url: `${SITE.url}/contacto/` }]}
>
  <p class="lead">
    {lang === 'es'
      ? 'Tres canales públicos según el motivo. Usamos GitHub para soporte e incidentes de seguridad (sin email ni formularios con tracking). Para datos personales, el controlador legal es IDK Manager.'
      : 'Three public channels by reason. We use GitHub for support and security incidents (no email, no tracked forms). For personal data, the legal controller is IDK Manager.'}
  </p>

  <div class="not-prose grid gap-4 md:grid-cols-3 my-8">
    {channels.map((c) => (
      <a
        href={c.href}
        rel="noopener"
        class="rounded-lg border border-ink-200 dark:border-ink-800 bg-ink-50 dark:bg-ink-900 p-5 hover:border-brand-400 transition-colors block"
      >
        <p class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-2">{c.label}</p>
        <p class="font-mono text-sm text-brand-500 mb-2 break-all">{c.cta} →</p>
        <p class="text-xs text-ink-600 dark:text-ink-300">{c.blurb}</p>
      </a>
    ))}
  </div>

  <h2>{lang === 'es' ? 'Política de divulgación responsable' : 'Responsible disclosure policy'}</h2>

  <p>
    {lang === 'es'
      ? 'Para reportes de seguridad usamos GitHub Security Advisories: privado por defecto, cifrado en tránsito, trazable, y permite coordinar el embargo y la publicación con quien lo reporta. No mantenemos clave PGP.'
      : 'For security reports we use GitHub Security Advisories: private by default, encrypted in transit, auditable, and supports coordinated embargo and disclosure with the reporter. We do not maintain a PGP key.'}
  </p>

  <ul>
    <li>{lang === 'es' ? 'Política completa' : 'Full policy'}: <a href="/.well-known/security.txt"><code>/.well-known/security.txt</code></a> (RFC 9116)</li>
    <li>{lang === 'es' ? 'Reporte privado' : 'Private report'}: <a href={SITE.securityUrl} rel="noopener">github.com/idkmanager/firma-ec/security/advisories/new</a></li>
  </ul>

  <h2>{lang === 'es' ? 'Issues y pull requests' : 'Issues and pull requests'}</h2>

  <p>
    {lang === 'es'
      ? 'Para temas de código, abre un issue o PR en GitHub:'
      : 'For code issues, open an issue or PR on GitHub:'}
  </p>

  <ul>
    <li><a href={SITE.githubOrg}>{SITE.githubOrg.replace('https://', '')}</a></li>
    <li><a href={SITE.githubPersonal}>{SITE.githubPersonal.replace('https://', '')}</a></li>
  </ul>

  <p>
    {lang === 'es'
      ? 'Para uso interno IDK Manager, repositorio primario en'
      : 'For IDK Manager internal use, primary repository at'} <a href={SITE.sourceCodeRepository}>{SITE.sourceCodeRepository.replace('https://', '')}</a>.
  </p>
</Page>
