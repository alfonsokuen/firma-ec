---
import { getLangFromUrl, localizedUrl, useTranslations } from '../i18n/utils.ts';
import Badge from './Badge.astro';
import HeroAnimation from './HeroAnimation.svelte';
import UsageCounter from './UsageCounter.svelte';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section class="container py-12 md:py-20" aria-labelledby="hero-title">
  <HeroAnimation client:visible>
    <p class="text-sm font-mono text-brand-500 mb-4 uppercase tracking-wider">
      {lang === 'es' ? 'Firma electrónica · Ecuador' : 'Electronic signature · Ecuador'}
    </p>
    <h1 id="hero-title" class="font-display text-[clamp(2rem,1.2rem+4vw,4rem)] font-bold leading-[1.05] tracking-[-0.02em] max-w-4xl mb-6">
      {lang === 'es'
        ? 'Firma y verifica PDFs con tu certificado electrónico .p12.'
        : 'Sign and verify PDFs with your .p12 electronic certificate.'}
    </h1>
    <p class="max-w-2xl text-lg md:text-xl text-ink-600 dark:text-ink-300 mb-8 text-pretty">
      {lang === 'es'
        ? '100% en tu navegador. Tu llave nunca sale de tu dispositivo. Open source. Cumple LOPDP por diseño.'
        : '100% in your browser. Your key never leaves your device. Open source. LOPDP-compliant by design.'}
    </p>
    <div class="flex flex-wrap items-center gap-3 mb-10">
      <a
        href={localizedUrl('firmar', lang)}
        class="inline-flex items-center gap-2 px-7 py-4 rounded-lg bg-brand-500 text-white font-semibold shadow-[0_8px_32px_-8px_color-mix(in_oklch,oklch(52%_0.18_240)_50%,transparent)] ring-1 ring-brand-600/30 hover:shadow-[0_16px_40px_-8px_color-mix(in_oklch,oklch(52%_0.18_240)_65%,transparent)] hover:-translate-y-0.5 transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] min-h-11"
      >
        {t('cta.firmar')}
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
      <a
        href={localizedUrl('verificar', lang)}
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-ink-300 dark:border-ink-700 hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors min-h-11"
      >
        {t('cta.verificar')}
        <span class="i-lucide-shield-check text-base" aria-hidden="true"></span>
      </a>
      <a
        href="https://app.firmar.ec/"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md text-sm font-medium text-brand-600 dark:text-brand-400 hover:bg-brand-500/5 transition-colors min-h-11"
      >
        {t('cta.abrir_app_full')}
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
    </div>
    <ul class="flex flex-wrap items-center gap-2 text-xs">
      <li><Badge label="Apache 2.0" tone="neutral" /></li>
      <li><Badge label="ETSI EN 319 142" tone="neutral" /></li>
      <li><Badge label="ARCOTEL TSL" tone="neutral" /></li>
      <li><Badge label="Mozilla Observatory A+" tone="ok" href="https://developer.mozilla.org/en-US/observatory/analyze?host=firmar.ec" /></li>
      <li><Badge label="SSL Labs A+" tone="ok" href="https://www.ssllabs.com/ssltest/analyze.html?d=firmar.ec" /></li>
      <li><Badge label="LOPDP nativa" tone="brand" /></li>
    </ul>
    <UsageCounter
      client:visible
      lang={lang}
      labels={lang === 'es'
        ? { signed: 'Documentos firmados', verified: 'Firmas verificadas', certs: 'Certificados emitidos' }
        : { signed: 'Documents signed', verified: 'Signatures verified', certs: 'Certificates issued' }}
    />
  </HeroAnimation>
</section>
