---
import { getLangFromUrl, localizedUrl, useTranslations } from '../i18n/utils.ts';
import { storeLink } from '../lib/store.ts';
import Badge from './Badge.astro';
import HeroAnimation from './HeroAnimation.svelte';
import HeroSponsors from './HeroSponsors.astro';
import UsageCounter from './UsageCounter.svelte';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const buyUrl = storeLink('hero');
---
<section class="hero container relative pt-6 md:pt-8 pb-12 md:pb-20 lt-md:pt-4" aria-labelledby="hero-title">
  <!-- Mobile-only ambient backdrop: soft brand glow + faded dot grid. Decorative,
       GPU-cheap (static gradients), pointer-events-none, hidden ≥768px so desktop
       is untouched. -->
  <div class="hero-deco" aria-hidden="true"></div>

  <HeroAnimation client:visible>
    <UsageCounter
      client:visible
      lang={lang}
      spacing="mb-3"
      mobileMax={2}
      labels={lang === 'es'
        ? { signed: 'Documentos firmados', verified: 'Firmas verificadas', validated: 'Certificados validados', certs: 'Certificados emitidos' }
        : { signed: 'Documents signed', verified: 'Signatures verified', validated: 'Certificates validated', certs: 'Certificates issued' }}
    />
    <a
      href={localizedUrl('estadisticas', lang)}
      class="inline-flex items-center gap-1 mb-8 lt-md:hidden text-sm font-medium text-ink-500 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950 rounded"
    >
      {t('stats.view')}
      <span class="i-lucide-arrow-up-right text-sm" aria-hidden="true"></span>
    </a>
    <p
      class="text-sm font-mono text-brand-500 mb-4 lt-md:mb-3 uppercase tracking-wider lt-md:inline-flex lt-md:items-center lt-md:gap-1.5 lt-md:rounded-full lt-md:border lt-md:border-brand-500/25 lt-md:bg-brand-500/[0.06] lt-md:px-3 lt-md:py-1 lt-md:text-[0.7rem] lt-md:tracking-wide"
    >
      <span class="hidden lt-md:inline-block size-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
      {lang === 'es' ? 'Firma electrónica · Ecuador · Gratis' : 'Electronic signature · Ecuador · Free'}
    </p>
    <h1 id="hero-title" class="font-display text-[clamp(2rem,1.2rem+4vw,4rem)] lt-md:text-[clamp(1.75rem,1.1rem+2.8vw,2.25rem)] font-bold leading-[1.05] tracking-[-0.02em] max-w-4xl mb-6 lt-md:mb-4">
      {lang === 'es'
        ? 'Firma y verifica documentos PDF gratis con tu certificado .p12.'
        : 'Sign and verify PDF documents for free with your .p12 certificate.'}
    </h1>
    <p class="max-w-2xl text-base md:text-lg text-ink-600 dark:text-ink-300 mb-7 lt-md:mb-6 text-pretty leading-relaxed">
      {lang === 'es'
        ? 'Sin costo para uso personal de todos los ecuatorianos. 100% en tu navegador: tu llave nunca sale de tu dispositivo. Sin registro, sin servidores. Open source · Cumple LOPDP.'
        : 'Free for personal use, for everyone in Ecuador. 100% in your browser: your key never leaves your device. No sign-up, no servers. Open source · LOPDP-compliant.'}
    </p>
    <!-- CTAs. Mobile: primary + verify full-width stacked (no text wrap); the
         tertiary "open full app" is dropped below md (it lives in the mobile menu)
         to keep the sponsor strip in the first viewport. Desktop unchanged: the
         lt-md:* utilities collapse to the original inline flex-wrap row at ≥768px. -->
    <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:items-center mb-10 lt-md:mb-5">
      <a
        href={localizedUrl('firmar', lang)}
        data-cta="firmar"
        class="inline-flex items-center gap-2 px-7 py-4 rounded-lg bg-brand-500 text-white font-semibold shadow-[0_8px_32px_-8px_color-mix(in_oklch,oklch(52%_0.18_240)_50%,transparent)] ring-1 ring-brand-600/30 hover:shadow-[0_16px_40px_-8px_color-mix(in_oklch,oklch(52%_0.18_240)_65%,transparent)] hover:-translate-y-0.5 transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] min-h-11 lt-md:w-full lt-md:justify-center"
      >
        {t('cta.firmar')}
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
      <a
        href={localizedUrl('verificar', lang)}
        data-cta="verificar"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md border border-ink-300 dark:border-ink-700 hover:bg-ink-100 dark:hover:bg-ink-800 transition-colors min-h-11 lt-md:w-full lt-md:justify-center lt-md:rounded-lg lt-md:py-3.5"
      >
        {t('cta.verificar')}
        <span class="i-lucide-shield-check text-base" aria-hidden="true"></span>
      </a>
      <!-- CTA de tienda (revenue): el certificado .p12 es el producto de pago. Ámbar,
           explícito. Desktop only para no empujar el strip de patrocinio above-the-fold
           en móvil — en móvil la tienda vive en el header sticky (siempre visible). -->
      <a
        href={buyUrl}
        data-cta="comprar_certificado"
        class="hidden md:inline-flex items-center gap-2 px-5 py-3 rounded-md font-semibold whitespace-nowrap shadow-sm ring-1 ring-black/5 hover:opacity-90 hover:-translate-y-0.5 transition-[transform,box-shadow,opacity] duration-200 ease-[cubic-bezier(0.4,0,0.2,1)] min-h-11"
        style="background:#C9821E;color:#11201a"
      >
        <span class="i-lucide-shopping-bag text-base" aria-hidden="true"></span>
        {lang === 'es' ? 'Comprar certificado' : 'Get a certificate'}
      </a>
      <a
        href="https://app.firmar.ec/"
        data-cta="abrir_app"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-md text-sm font-medium text-brand-600 dark:text-brand-400 hover:bg-brand-500/5 transition-colors min-h-11 lt-md:hidden"
      >
        {t('cta.abrir_app_full')}
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
    </div>
    <HeroSponsors />
    <ul class="mt-2 flex flex-wrap items-center gap-2 lt-md:gap-1.5 text-xs">
      <li><Badge label={lang === 'es' ? 'Gratis' : 'Free'} tone="ok" /></li>
      <li><Badge label="AGPL-3.0" tone="neutral" /></li>
      <li class="lt-md:hidden"><Badge label="ETSI EN 319 142" tone="neutral" /></li>
      <li class="lt-md:hidden"><Badge label="ARCOTEL TSL" tone="neutral" /></li>
      <li class="lt-md:hidden"><Badge label="Mozilla Observatory A+" tone="ok" href="https://developer.mozilla.org/en-US/observatory/analyze?host=firmar.ec" /></li>
      <li class="lt-md:hidden"><Badge label="SSL Labs A+" tone="ok" href="https://www.ssllabs.com/ssltest/analyze.html?d=firmar.ec" /></li>
      <li><Badge label="LOPDP nativa" tone="brand" /></li>
    </ul>
  </HeroAnimation>
</section>

<style>
  /* Decorative hero backdrop — mobile only. Desktop renders nothing (display:none),
     so the existing desktop hero is byte-for-byte unchanged. */
  .hero-deco { display: none; }

  @media (max-width: 767.98px) {
    .hero { position: relative; isolation: isolate; }
    .hero-deco {
      display: block;
      position: absolute;
      z-index: -1;
      top: -3.5rem;
      left: -1rem;
      right: -1rem;
      height: 26rem;
      pointer-events: none;
      background: radial-gradient(
        80% 55% at 50% 0%,
        color-mix(in oklch, var(--brand-500) 13%, transparent) 0%,
        transparent 70%
      );
    }
    .hero-deco::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, var(--ink-300) 1px, transparent 1.5px);
      background-size: 20px 20px;
      opacity: 0.5;
      -webkit-mask-image: linear-gradient(to bottom, oklch(0% 0 0) 0%, transparent 75%);
      mask-image: linear-gradient(to bottom, oklch(0% 0 0) 0%, transparent 75%);
    }
    [data-theme="dark"] .hero-deco {
      background: radial-gradient(
        80% 55% at 50% 0%,
        color-mix(in oklch, var(--brand-400) 16%, transparent) 0%,
        transparent 70%
      );
    }
    [data-theme="dark"] .hero-deco::before {
      background-image: radial-gradient(circle, var(--ink-700) 1px, transparent 1.5px);
      opacity: 0.4;
    }
  }
</style>
