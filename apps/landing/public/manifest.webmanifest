{
  "name": "firmar.ec",
  "short_name": "firmar.ec",
  "description": "Firma electrónica ecuatoriana en tu navegador. PWA pública, open source, cumple LOPDP por diseño.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "browser",
  "theme_color": "#0B1A3A",
  "background_color": "#0B1A3A",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "related_applications": [
    { "platform": "webapp", "url": "https://app.firmar.ec/manifest.webmanifest" }
  ]
}
