---
import { getLangFromUrl, useTranslations, localizedUrl } from '../i18n/utils.ts';
import { SITE } from '../lib/jsonld.ts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="border-t border-ink-200 dark:border-ink-800 mt-16">
  <div class="container py-10 grid gap-8 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-base font-bold tracking-tight">
        <span class="text-brand-500">firmar</span><span class="text-ink-500">.ec</span>
      </p>
      <p class="mt-3 text-sm text-ink-600 dark:text-ink-400 max-w-prose">
        {lang === 'es'
          ? 'PWA pública ecuatoriana de firma y verificación de PDFs. Open source. Cumple LOPDP por diseño.'
          : 'Ecuadorian public PWA for signing and verifying PDFs. Open source. LOPDP-compliant by design.'}
      </p>
      <p class="mt-3 text-xs text-ink-500">
        {t('footer.operado')} <a class="text-brand-500 hover:underline" href={SITE.operatorUrl}>IDK Manager</a>
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold mb-3">{t('footer.legal')}</h3>
      <ul class="space-y-2 text-sm text-ink-600 dark:text-ink-400">
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={localizedUrl('privacidad', lang)}>{t('footer.privacidad')}</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={localizedUrl('terminos', lang)}>{t('footer.terminos')}</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={localizedUrl('seguridad', lang)}>{t('footer.seguridad')}</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={localizedUrl('contacto', lang)}>{t('footer.contacto')}</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50" href={localizedUrl('glosario', lang)}>{t('footer.glosario')}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold mb-3">{t('nav.repos')}</h3>
      <ul class="space-y-2 text-sm text-ink-600 dark:text-ink-400">
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50 font-mono text-xs" href={SITE.githubOrg}>github.com/idkmanager</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50 font-mono text-xs" href={SITE.githubPersonal}>github.com/alfonsokuen</a></li>
        <li><a class="hover:text-ink-900 dark:hover:text-ink-50 font-mono text-xs" href={SITE.sourceCodeRepository}>git.idkmanager.com</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-200 dark:border-ink-800">
    <div class="container flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 py-4 text-xs text-ink-500">
      <p>© {year} firmar.ec · {t('footer.licencia')}</p>
      <p>
        <a href="/.well-known/security.txt" class="hover:text-ink-700 dark:hover:text-ink-300">security.txt</a>
      </p>
    </div>
  </div>
</footer>
