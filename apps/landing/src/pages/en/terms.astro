---
import Page from '../../layouts/Page.astro';
import { render, getEntry } from 'astro:content';
import { legalDocument, SITE } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/terms');
if (!entry) throw new Error('Missing content/pages/en/terms.md');
const { Content } = await render(entry);
const data = entry.data;

const pageProps = {
  title: data.title,
  description: data.description,
  routeKey: 'terminos' as const,
  breadcrumbs: data.breadcrumbs,
  ...(data.h1 !== undefined ? { h1: data.h1 } : {}),
};
---
<Page {...pageProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(legalDocument({ lang: 'en', type: 'TermsOfService', url: `${SITE.url}/en/terms` }))}></script>
</Page>
