---
// Anuncio de intención (positioning) — emisión de certificados próximamente.
// Sin formulario ni captura de datos: respeta la postura "sin formularios, sin
// tracking" del sitio. No nombra proveedor ni precios (acuerdo en negociación).
import { getLangFromUrl } from '../i18n/utils.ts';
const lang = getLangFromUrl(Astro.url);
---
<aside class="not-prose my-8 rounded-xl border border-brand-400 bg-brand-500/10 p-5 md:p-6">
  <p class="text-xs font-mono uppercase tracking-wider text-brand-600 dark:text-brand-400 mb-2">
    {lang === 'es' ? 'Próximamente' : 'Coming soon'}
  </p>
  <h2 class="font-display text-lg md:text-xl font-semibold leading-snug mb-2">
    {lang === 'es'
      ? 'Tu certificado y tu firma, en un solo lugar'
      : 'Your certificate and your signature, in one place'}
  </h2>
  <p class="text-ink-700 dark:text-ink-300">
    {lang === 'es'
      ? 'Estamos habilitando la emisión de certificados de firma electrónica directamente desde firmar.ec, para que obtengas tu certificado y firmes tus PDFs sin dar vueltas. La herramienta de firma seguirá siendo gratis y open source, siempre.'
      : 'We are enabling electronic signature certificate issuance directly from firmar.ec, so you can get your certificate and sign your PDFs without the runaround. The signing tool will stay free and open source — always.'}
  </p>
  <p class="mt-3">
    <a
      class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 dark:text-brand-400 hover:underline"
      href="https://app.firmar.ec/"
    >
      {lang === 'es' ? 'Probar la firma gratis ahora' : 'Try free signing now'}
      <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
    </a>
  </p>
</aside>
