---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../layouts/ArticleSeo.astro';
import { howTo } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/como-firmar-con-certificado-bce');
if (!entry) throw new Error('Missing content/pages/es/como-firmar-con-certificado-bce.md');
const { Content } = await render(entry);
const data = entry.data;

const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  totalTime: 'PT3M',
  steps: [
    {
      name: 'Carga el PDF',
      text: 'Arrastra o selecciona el PDF que quieres firmar en app.firmar.ec/firmar.',
      url: 'https://app.firmar.ec/firmar',
    },
    {
      name: 'Coloca el cuadro de firma',
      text: 'Posiciona y redimensiona el sello visible (con QR de verificación) sobre el documento.',
    },
    {
      name: 'Carga tu certificado .p12',
      text: 'La app valida que sea de una ECI ecuatoriana acreditada por ARCOTEL y que esté vigente.',
    },
    {
      name: 'Ingresa la contraseña',
      text: 'Se usa solo para importar la llave en tu navegador y se borra de inmediato; no se envía a ningún servidor.',
    },
    {
      name: 'Revisa y firma',
      text: 'La firma se calcula en un Web Worker dedicado dentro de tu navegador.',
    },
    {
      name: 'Descarga el PDF firmado',
      text: 'El archivo resultante es PAdES, plenamente válido.',
    },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'como-firmar-con-certificado-bce',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
