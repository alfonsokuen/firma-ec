// Prisma schema for firmar.ec inbox-backend (F3.5).
//
// Privacy: phone numbers are stored as HMAC-SHA256 hashes (server-side pepper).
// OTPs are stored as Argon2id hashes. Encrypted PDFs live in R2; only the
// derived-key fingerprint hint is stored in DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PdfStatus {
  PENDING
  SIGNED
  DELIVERED
  EXPIRED
  SENT
  DELETED
}

model PendingPdf {
  id               String    @id @default(cuid())
  otpHash          String    @unique
  senderPhoneHash  String
  messageId        String    @unique
  r2Key            String
  // PBKDF2 salt (16 bytes) bound to this PDF — required for client decrypt.
  salt             Bytes
  sizeBytes        Int
  // First 4 bytes of derived key for fingerprint check (NOT the key itself).
  encryptedKeyHint String?
  createdAt        DateTime  @default(now())
  ttlAt            DateTime
  status           PdfStatus @default(PENDING)
  consumedAt       DateTime?
  deletedAt        DateTime?

  @@index([senderPhoneHash])
  @@index([ttlAt])
  @@index([status])
  @@map("pending_pdfs")
}

// Anonymous, privacy-safe usage counters powering the public landing stats
// (firmas/verificaciones). No PII, no per-event rows — just a running total
// per key. Signing/verification happen client-side (zero-knowledge), so these
// are best-effort usage tallies fed by an anonymous beacon, not attestable
// proofs. Incremented atomically via ON CONFLICT.
model UsageCounter {
  key       String   @id
  count     BigInt    @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("usage_counters")
}

model AuditLog {
  id                 String   @id @default(cuid())
  event              String
  // Encrypted body: 12-byte IV concatenated with AES-GCM ciphertext+tag.
  payloadCiphertext  Bytes
  // Version of INBOX_AUDIT_KEY used; supports key rotation for forensics.
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())

  @@index([event, createdAt])
  @@map("audit_logs")
}
