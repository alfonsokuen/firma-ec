// Prisma schema for firmar.ec inbox-backend (F3.5).
//
// Privacy: phone numbers are stored as HMAC-SHA256 hashes (server-side pepper).
// OTPs are stored as Argon2id hashes. Encrypted PDFs live in R2; only the
// derived-key fingerprint hint is stored in DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PdfStatus {
  PENDING
  SIGNED
  DELIVERED
  EXPIRED
  SENT
  DELETED
}

model PendingPdf {
  id               String    @id @default(cuid())
  otpHash          String    @unique
  senderPhoneHash  String
  messageId        String    @unique
  r2Key            String
  // PBKDF2 salt (16 bytes) bound to this PDF — required for client decrypt.
  salt             Bytes
  sizeBytes        Int
  // First 4 bytes of derived key for fingerprint check (NOT the key itself).
  encryptedKeyHint String?
  createdAt        DateTime  @default(now())
  ttlAt            DateTime
  status           PdfStatus @default(PENDING)
  consumedAt       DateTime?
  deletedAt        DateTime?

  @@index([senderPhoneHash])
  @@index([ttlAt])
  @@index([status])
  @@map("pending_pdfs")
}

// Anonymous, privacy-safe usage counters powering the public landing stats
// (firmas/verificaciones). No PII, no per-event rows — just a running total
// per key. Signing/verification happen client-side (zero-knowledge), so these
// are best-effort usage tallies fed by an anonymous beacon, not attestable
// proofs. Incremented atomically via ON CONFLICT.
model UsageCounter {
  key       String   @id
  count     BigInt    @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@map("usage_counters")
// ─── F9 — compra/emisión de certificados (ArgosData/Signare) ───
// LOPDP: NO se persisten en BD las imágenes de identidad/prueba de vida.
// Los archivos viven cifrados en la bóveda (R2) y se purgan tras enviar a
// Signare. Aquí solo el ciclo de vida de la orden + PII mínima de contacto.

enum CertOrderStatus {
  PENDING_PAYMENT
  PAID
  SUBMITTED
  PAYMENT_FAILED
  SUBMIT_FAILED
}

model CertOrder {
  id            String          @id @default(uuid())
  status        CertOrderStatus @default(PENDING_PAYMENT)
  // PVP cobrado al público (Asociado), con IVA.
  pvp           Decimal         @db.Decimal(10, 2)
  email         String
  pricingPlanId Int
  // Input de la solicitud SIN los bytes de archivos (PII de contacto + flags).
  certInput     Json
  // Referencia a los archivos en la bóveda cifrada (R2). Se anula al purgar.
  filesRef      String?
  paymentId     String?
  paymentUrl    String?
  certCode      String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  events        CertOrderEvent[]

  @@index([status])
  @@map("cert_orders")
}

model CertOrderEvent {
  id      String    @id @default(cuid())
  orderId String
  order   CertOrder @relation(fields: [orderId], references: [id])
  type    String
  payload Json
  at      DateTime  @default(now())

  @@index([orderId])
  @@map("cert_order_events")
}

model AuditLog {
  id                 String   @id @default(cuid())
  event              String
  // Encrypted body: 12-byte IV concatenated with AES-GCM ciphertext+tag.
  payloadCiphertext  Bytes
  // Version of INBOX_AUDIT_KEY used; supports key rotation for forensics.
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())

  @@index([event, createdAt])
  @@map("audit_logs")
}
